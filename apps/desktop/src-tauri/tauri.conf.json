{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen OS",
  "version": "0.1.0",
  "identifier": "com.lumenpearson.lumenos",
  "build": {
    "beforeDevCommand": "pnpm --filter @lumen/desktop dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --filter @lumen/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen OS",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "maximized": true,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "* https: http: blob: data:",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5174 ws://localhost:5175 http://localhost:5174",
        "frame-src": "* https: http: blob: data:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Lumen OS desktop environment",
    "longDescription": "A desktop operating environment: shell, windowing, files and built-in applications, running natively over a sandboxed Rust kernel.",
    "publisher": "Lumen Pearson",
    "homepage": "https://github.com/lumenpearson/os",
    "copyright": "Copyright (c) 2026 Lumen Pearson",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["xdg-utils"],
        "section": "utils"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "recommends": ["xdg-utils"]
      }
    }
  },
  "plugins": {
    "window-state": {}
  }
}
