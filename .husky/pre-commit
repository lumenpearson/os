pnpm lint-staged

# Cheap, and it catches a class of breakage that is invisible on Linux: two
# modules in one directory whose names differ only by case resolve
# ambiguously on macOS and Windows. It has already cost two red builds, both
# times because it was only checked in CI.
pnpm check:portability

# The landing page's app list has to be the one the OS ships.
pnpm check:apps
pnpm check:i18n
